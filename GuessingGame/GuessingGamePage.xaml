<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GuessingGame.GuessingGamePage"
             Title="Guessing Game">
    <VerticalStackLayout Padding="8,8,8,8" Spacing="25">
        

        <Image Source="spike.png" HeightRequest="160"/>

        <Label Text="Guess a number" x:Name="feedbackLabel" />
        
        
        <Border Padding="8">
            
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            
            
        <Entry Placeholder="Guess The number" Keyboard="Numeric" x:Name="guessingEntry"/>
            
        </Border>

        
        <Button Text="Guess" x:Name="guessButton" Clicked="guessButton_Clicked"/>

        <Button Text="Restart" Clicked="Button_Clicked"/>
    </VerticalStackLayout>
</ContentPage>