<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GuessingGame.SliderDemoPage"
             Title="SliderDemoPage">
    <VerticalStackLayout Spacing="25">
        <Label 
            Text="Slide Me"
            VerticalOptions="Center" 
            HorizontalOptions="Center" FontSize="40" FontAttributes="Bold" x:Name="SlideMeLabel"/>

        <Slider x:Name="DemoSlider" ValueChanged="Slider_ValueChanged"/>
        <Label x:Name="SliderValueLabel" Text="0" FontSize="40" FontAttributes="Bold" HorizontalTextAlignment="Center"/>


    </VerticalStackLayout>
</ContentPage>